        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const queries = $input.all()\n  .map(i => String(i.json?.vat_or_id || i.json?.query || '').trim())\n  .filter(Boolean);\nif (!queries.length) return [];\nreturn [{ json: { queries, validateVat: true, enrichGleifLei: true, screenSanctions: true, concurrency: 3 } }];"
      },
